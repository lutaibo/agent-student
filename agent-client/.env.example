# 任何 OpenAI 兼容服务都可以，改 BASE_URL + MODEL 即可
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.agnes-ai.cn/v1

# 模型名以网关为准，写错会返回 404（前端提示"模型不存在"）。
# 当前网关的对话模型（2026-11 实测）：
#   agnes-2.5-flash   免费额度可用，工具调用正常（含并行调用），默认
#   agnes-3.0-flash   免费额度可用，有速率限制（429 需退避重试）
#   agnes-2.5-pro     需付费额度，余额为 0 时返回 403 insufficient_user_quota
# 换网关/不确定时先查列表：
#   curl "$OPENAI_BASE_URL/models" -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL=agnes-2.5-flash

# AgentClient 行为
AGENT_TIMEOUT_MS=60000
AGENT_MAX_RETRIES=2
AGENT_LOG_LEVEL=info
